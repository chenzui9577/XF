    <select id="queryAllBySystype" resultMap="sys_sscMap">
        SELECT DISTINCT eqd.*,eqt.`Name_eqt` FROM sys_equideti eqd
        LEFT JOIN sys_equitype eqt ON  eqt.Systype = #{Systype}
        WHERE CONCAT(eqt.Notes, '') like CONCAT('%,',eqd.`Name`,',%')
    </select>
    <!--查看该项目中某个部件类型中的部件信息-->
    <select id="queryAllByName_eqt" resultMap="sys_sscMap">
        SELECT DISTINCT eqd.*,eqt.`Name_eqt` FROM sys_equideti eqd
        LEFT JOIN sys_equitype eqt ON  eqt.Name_eqt = #{Name_eqt}
        WHERE CONCAT(eqt.Notes, '') like CONCAT('%,',eqd.`Name`,',%')
    </select>
    <select id="queryAll" resultMap="sys_sscMap" parameterType="String">
        SELECT DISTINCT eqd.*,eqt.`Name_eqt` FROM sys_equideti eqd
            LEFT JOIN sys_equitype eqt ON CONCAT(eqt.Notes, '') like CONCAT('%,',eqd.`Name`,',%')
    </select>



